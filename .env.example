# SecureRoom development environment
# Copy this file to .env and replace the secret/database values as needed.

APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Set true to run locally without PostgreSQL (data is lost on process restart).
USE_IN_MEMORY_DB=true
DATABASE_URL=postgresql+psycopg2://secureroom_user:secureroom_password@localhost:5432/secureroom

# Use a unique random value outside local development.
SESSION_SECRET=change_me_to_a_secure_random_string_at_least_32_chars
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
