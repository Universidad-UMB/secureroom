# SecureRoom v1 — Environment Configuration Example
# Copy this file to .env and configure values before starting the application.

# Application Environment: 'development' or 'production'
APP_ENV=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# PostgreSQL Connection String
DATABASE_URL=postgresql://secureroom_user:secureroom_password@postgres:5432/secureroom

# Session Secret (Generate a strong random 32+ character string in production)
SESSION_SECRET=change_me_to_a_secure_random_string_at_least_32_chars

# Cookie Security Settings (set to true in production with HTTPS)
SESSION_COOKIE_SECURE=false

# Session duration in seconds (8 hours = 28800)
SESSION_MAX_AGE_SECONDS=28800
